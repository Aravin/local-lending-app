# Android Release Keystore Configuration Template
# Copy this file to android/key.properties and set your values.
# NEVER commit android/key.properties or your *.jks keystore to Git.
#
# To generate a new upload keystore, run:
# keytool -genkey -v -keystore local_lending.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=upload
storeFile=../local_lending.jks
